# ==============================================================================
# Badminton Tournament Finder - Production Environment Configuration
# ==============================================================================

# Environment Mode
ENVIRONMENT=production
NODE_ENV=production
USE_MOCK_DATA=false

# Domain & SSL
DOMAIN_NAME=badmintonfinder.org
ACME_EMAIL=admin@badmintonfinder.org

# MongoDB Atlas (Production Replica Set with SSL)
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/badminton_prod?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://prod_user:CHANGE_ME_PASSWORD@cluster0.mongodb.net/badminton_prod?retryWrites=true&w=majority

# Redis (Production with Password Authentication & TLS)
REDIS_URL=rediss://:CHANGE_ME_REDIS_PASSWORD@redis.badmintonfinder.org:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Apache Kafka (Production Managed Cluster - Confluent / MSK / Strimzi)
KAFKA_BOOTSTRAP_SERVERS=kafka.badmintonfinder.org:9092
KAFKA_TOPIC_TOURNAMENTS=tournaments.events.prod
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=prod_kafka_user
KAFKA_SASL_PASSWORD=CHANGE_ME_KAFKA_PASSWORD

# Python Scraper & AI Layer
OPENAI_API_KEY=YOUR_PROD_OPENAI_API_KEY
APIFY_API_TOKEN=apify_api_token_prod
BRIGHT_DATA_API_KEY=bright_data_key_prod
MOBILE_PROXY_URL=http://proxy_user:proxy_pass@residential.proxyprovider.com:8080
RESIDENTIAL_PROXY_URL=http://proxy_user:proxy_pass@residential.proxyprovider.com:8080

# Java Spring Boot Core Service
CORE_SERVICE_PORT=8081
GEOCODING_API_KEY=prod_google_maps_or_nominatim_key
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_64_CHARACTERS_LONG

# API Gateway & Rate Limiting (Bucket4j + Resilience4j)
GATEWAY_PORT=8080
RATE_LIMIT_BURST_CAPACITY=40
RATE_LIMIT_REFILL_TOKENS=20
RATE_LIMIT_REFILL_DURATION=60s

# Web Client URLs
VITE_API_GATEWAY_URL=https://badmintonfinder.org
VITE_WS_GATEWAY_URL=wss://badmintonfinder.org/ws

