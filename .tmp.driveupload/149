name: 🏸 Request New Tournament Source
description: Suggest a new collegiate badminton club or Instagram handle to monitor
title: "[SOURCE]: "
labels: ["data-source", "new-club"]
body:
  - type: markdown
    attributes:
      value: |
        Help expand our tournament coverage! Suggest an active collegiate club.
  - type: input
    id: club_name
    attributes:
      label: Club / University Name
      description: e.g. Virginia Tech Badminton Club
    validations:
      required: true
  - type: input
    id: ig_handle
    attributes:
      label: Instagram Handle
      description: e.g. @vtbadmintonclub
    validations:
      required: true
  - type: input
    id: linktree_url
    attributes:
      label: Linktree / Bio URL (Optional)
      description: e.g. https://linktr.ee/vtbadminton
  - type: dropdown
    id: region
    attributes:
      label: Region / State
      options:
        - "DMV (DC, Maryland, Virginia)"
        - "Mid-Atlantic / Northeast"
        - "Midwest"
        - "West Coast"
        - "South / Southeast"
        - "Other"
    validations:
      required: true

