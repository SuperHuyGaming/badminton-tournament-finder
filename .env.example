# ==============================================================================
# Badminton Tournament Finder - Environment Configuration
# ==============================================================================

# General
ENVIRONMENT=development
USE_MOCK_DATA=true

# Databases & Messaging
MONGO_URI=mongodb://localhost:27017/badminton_db?replicaSet=rs0
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TOURNAMENTS=tournaments.events

# Scraper & AI Layer (Python)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
APIFY_API_TOKEN=your-apify-token-here
BRIGHT_DATA_API_KEY=your-bright-data-key-here
MOBILE_PROXY_URL=http://user:pass@proxy.example.com:8080
RESIDENTIAL_PROXY_URL=http://user:pass@res-proxy.example.com:8080

# Spring Boot Core Service (Java)
CORE_SERVICE_PORT=8081
GEOCODING_API_KEY=your-geocoding-key-or-mock

# API Gateway (Spring Cloud Gateway)
GATEWAY_PORT=8080
RATE_LIMIT_BURST_CAPACITY=20
RATE_LIMIT_REFILL_TOKENS=20
RATE_LIMIT_REFILL_DURATION=60s

# Web Client (React + MUI)
VITE_API_GATEWAY_URL=http://localhost:8080
VITE_WS_GATEWAY_URL=ws://localhost:8080/ws

